AI_PROVIDER=hybrid
BITMIND_ENABLED=true
BITMIND_API_KEY=
BITMIND_BASE_URL=https://api.bitmind.ai/oracle/v1
BITMIND_TIMEOUT_SECONDS=180
BITMIND_MONTHLY_QUOTA=100
BITMIND_USE_ON_INCONCLUSIVE=true
BITMIND_USE_ON_SUSPICIOUS=true
BITMIND_ALWAYS_USE_FOR_PAID_USERS=false
LOCAL_FALLBACK_ENABLED=true
EXTERNAL_PROVIDER_POLICY=OnUncertain

