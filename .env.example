APP_ENV=production
AI_MODE=real
AI_PROVIDER=hybrid
AI_SERVICE_API_KEY=__SET_32_CHAR_MINIMUM_SHARED_SECRET__
AI_ALLOWED_VIDEO_ROOTS=__ABSOLUTE_BACKEND_WORK_ROOT__
BITMIND_ENABLED=true
BITMIND_API_KEY=__SET_IN_SECRET_MANAGER__
BITMIND_BASE_URL=https://api.bitmind.ai/oracle/v1
BITMIND_TIMEOUT_SECONDS=180
BITMIND_MONTHLY_QUOTA=100
BITMIND_USE_ON_INCONCLUSIVE=true
BITMIND_USE_ON_SUSPICIOUS=true
BITMIND_ALWAYS_USE_FOR_PAID_USERS=false
LOCAL_FALLBACK_ENABLED=true
EXTERNAL_PROVIDER_POLICY=OnUncertain
ENABLE_MOCK_FALLBACK=false
AI_DEBUG_OUTPUT=false

# Development testing
# APP_ENV=development
# AI_MODE=mock
# AI_PROVIDER=bitmind
# EXTERNAL_PROVIDER_POLICY=Always

# Cost-saving free plan
# AI_PROVIDER=hybrid
# EXTERNAL_PROVIDER_POLICY=OnUncertain
